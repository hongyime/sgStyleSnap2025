{
  "name": "stylesnap",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "npx vite",
    "build": "npm run type-check && vite build",
    "build:check": "npm run build",
    "preview": "vite preview",
    "type-check": "vue-tsc --noEmit",
    "lint": "eslint . --ext js,vue,ts --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --ext js,vue,ts --fix",
    "test": "vitest run --maxWorkers=1 --no-file-parallelism",
    "test:smoke": "playwright test --config playwright.smoke.config.js",
    "test:media-views": "playwright test --config playwright.media.config.js",
    "test:uploads": "playwright test --config playwright.uploads.config.js",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "purge-old-items": "echo 'Purge script not implemented yet' && exit 0",
    "cloudinary-cleanup": "echo 'Cloudinary cleanup script not implemented yet' && exit 0",
    "test:media-access": "node --test --test-concurrency=1 tests/maintenance/stylesnap-media-access.test.mjs tests/maintenance/stylesnap-private-reader.test.mjs tests/maintenance/stylesnap-binding-publication.test.mjs tests/maintenance/stylesnap-binding-versions.test.mjs tests/maintenance/stylesnap-upload-receipts.test.mjs tests/maintenance/stylesnap-trusted-upload.test.mjs tests/maintenance/stylesnap-upload-flow.test.mjs tests/maintenance/stylesnap-catalog-adoption.test.mjs",
    "test:catalog": "playwright test --config playwright.catalog.config.js"
  },
  "dependencies": {
    "@getbrevo/brevo": "^5.0.4",
    "@google/genai": "^1.51.0",
    "@huggingface/inference": "^4.13.0",
    "@studio-freight/lenis": "^1.0.42",
    "@supabase/supabase-js": "^2.105.1",
    "@vueuse/core": "^14.3.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.0.0",
    "lucide-vue-next": "^1.0.0",
    "modern-rembg": "^0.1.2",
    "motion": "^12.23.24",
    "onnxruntime-web": "1.18.0",
    "pinia": "^3.0.4",
    "tailwind-merge": "^3.5.0",
    "three": "^0.184.0",
    "vue": "^3.4.0",
    "vue-router": "^5.0.6"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@playwright/test": "^1.40.0",
    "@tailwindcss/postcss": "^4.2.4",
    "@types/node": "^25.5.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/test-utils": "^2.5.0",
    "@vue/tsconfig": "^0.9.1",
    "autoprefixer": "^10.4.16",
    "esbuild": "^0.28.2",
    "eslint": "^10.1.0",
    "eslint-plugin-vue": "^10.9.0",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.2.4",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "vitest": "^5.0.0",
    "vue-eslint-parser": "^10.4.0",
    "vue-tsc": "^3.1.2"
  },
  "overrides": {
    "protobufjs": "7.6.5",
    "ws": "8.21.1"
  }
}
